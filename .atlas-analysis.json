  "keyFeatures": [
    "MDX-based documentation pages with rich component support",
    "Git-driven publishing via GitHub App integration",
    "AI-assisted writing with support for Claude, ChatGPT, Cursor, and more",
    "Customizable branding, navigation, and site settings via docs.json",
    "Built-in search powered by contextual AI",
    "Custom domain support",
    "Versioning for multi-version documentation",
    "Analytics and third-party integrations",
    "Local preview via Mintlify CLI"
  ],
  "publicApiSurface": [
    "docs.json — site configuration file",
    "mint dev — local preview CLI command",
    "mint validate — configuration validation CLI command",
    "mint broken-links — broken link checker CLI command",
    "npx skills add — AI coding tool skill installer",
    "MDX frontmatter fields: title, description, url, sidebarTitle, icon",
    "Navigation schema: tabs, groups, pages, anchors",
    "Components: Card, Tip, Steps, Step, CodeBlock, Callout",
    "GitHub App for auto-deploy on push"
  ]
